{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "cic:o1:sign-send-request",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "v",
  "signing_profile",
  "key_ref",
  "request",
  "intent"
 ],
 "properties": {
  "v": {
   "const": 1
  },
  "signing_profile": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+:[a-z0-9-]+@[0-9]+$"
  },
  "key_ref": {
   "type": "string",
   "pattern": "^[a-z]+/[a-z0-9-]+$"
  },
  "request": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "method",
    "host",
    "path"
   ],
   "properties": {
    "method": {
     "enum": [
      "GET",
      "HEAD",
      "POST",
      "PUT",
      "PATCH",
      "DELETE"
     ]
    },
    "host": {
     "type": "string",
     "pattern": "^[a-z0-9.-]+$"
    },
    "path": {
     "type": "string",
     "pattern": "^/[^?#\\s]*$"
    },
    "query": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "headers": {
     "type": "object",
     "propertyNames": {
      "pattern": "^[a-z0-9-]+$",
      "not": {
       "enum": [
        "authorization",
        "date",
        "host",
        "content-length",
        "x-content-sha256",
        "signature"
       ]
      }
     },
     "additionalProperties": {
      "type": "string"
     }
    },
    "body": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "base64"
     ],
     "properties": {
      "base64": {
       "type": "string"
      }
     }
    }
   }
  },
  "intent": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "operation",
    "resource_id",
    "binding_digest"
   ],
   "properties": {
    "operation": {
     "type": "string"
    },
    "resource_id": {
     "type": "string"
    },
    "binding_digest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    }
   }
  },
  "trace_id": {
   "type": "string",
   "maxLength": 128
  }
 }
}