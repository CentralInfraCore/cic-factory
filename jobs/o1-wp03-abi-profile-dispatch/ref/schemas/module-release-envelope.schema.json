{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "cic:o1:module-release-envelope",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kind",
  "envelope_version",
  "module_id",
  "wasm_sha256",
  "executed_wasm_sha256",
  "manifest_digest",
  "signer"
 ],
 "properties": {
  "kind": {
   "const": "ModuleReleaseEnvelope"
  },
  "envelope_version": {
   "const": 1
  },
  "module_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]*@v?[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "wasm_sha256": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "executed_wasm_sha256": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "manifest_digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "signer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key_id",
    "alg"
   ],
   "properties": {
    "key_id": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "alg": {
     "enum": [
      "ecdsa-p256-sha256",
      "ed25519"
     ]
    }
   }
  }
 }
}